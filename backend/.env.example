PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/hrms

# Required - use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me

# First super-admin account (created on startup if it does not exist)
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=ChangeThisStrongPassword

# Optional - comma separated list of allowed frontend origins (default: all)
CLIENT_URL=http://localhost:3000

# Optional - base URL shown in Swagger
SWAGGER_SERVER_URL=http://localhost:5000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
